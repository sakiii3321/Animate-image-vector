# Publish the test source, not workstation-specific execution records
/tests/*.json
!/tests/package.json
!/tests/package-lock.json
/tests/*.txt
/tests/*.png
/tests/*.svg
/tests/*.log
/experiments/performance_geometry_report.md

# Installed interpreters, packages and optional binary assets stay local
/runtime/*
!/runtime/potrace/
/runtime/potrace/*
